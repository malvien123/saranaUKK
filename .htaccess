# Mengaktifkan pengaturan URL Rewrite
RewriteEngine On
RewriteBase /

# Mencegah direktori dilihat isinya demi keamanan
Options -Indexes

# 1. Jangan ubah atau alihkan file apa pun yang berada di dalam folder Controller
RewriteCond %{REQUEST_URI} ^/Controller/ [NC]
RewriteRule .* - [L]

# 2. Secara otomatis membuang ekstensi .php dari address bar browser
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 3. Cek file .php di root folder (htdocs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]

# 4. Cek file .php di dalam subfolder (seperti View/v_login.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1\.php -f
RewriteRule ^(.+)$ $1\.php [L]