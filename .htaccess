# Mengaktifkan pengaturan URL Rewrite
RewriteEngine On
Options -Indexes

# 1. Abaikan file fisik atau folder nyata (gambar, CSS, JS, folder uploads)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Pengecualian folder khusus agar tidak terganggu rewrite
RewriteCond %{REQUEST_URI} ^/(uploads|Controller)/ [NC]
RewriteRule .* - [L]

# 3. REDIRECT EKSTERNAL: Jika ada user/link lama yang masih mengakses .php, paksa buang .php-nya dari address bar
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 4. REWRITE INTERNAL (FOLDER VIEW & ROOT): 
# Memetakan URL bersih (tanpa .php) ke file .php aslinya secara transparan di background
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/saranaUKK/View/$1.php -f
RewriteRule ^(.+)$ View/$1.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/saranaUKK/$1.php -f
RewriteRule ^(.+)$ $1.php [L]